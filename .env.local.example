# Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Programszervező modul (planner) -- lásd a tervdokumentumot.
# Csak Preview/dev környezetben állítsd true-ra. Production env-ben ne
# módosítsd -- a modul a middleware-ben flag nélkül 404-et ad.
NEXT_PUBLIC_FEATURE_PLANNER=false

# A planner modul KÜLÖN Supabase projektet használ, elkülönítve a fenti
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEY-től (ami a fő oldal production
# projektje). Csak Preview/dev környezetben állítsd be -- production env-ben
# hagyd üresen.
NEXT_PUBLIC_PLANNER_SUPABASE_URL=your_planner_supabase_project_url
NEXT_PUBLIC_PLANNER_SUPABASE_ANON_KEY=your_planner_supabase_anon_key

# Az admin panel bejelentkezése a FŐ oldal Supabase projektjén él, nem a
# planner projekten -- így az admin server actionök soha nem hitelesítenek
# a planner projekten anon kulccsal (mindig anonként érkeznek). Ez a
# service-role kulcs kell nekik az RLS megkerüléséhez -- Supabase Settings
# → API → service_role key, a PLANNER projekten (nem a fő oldalén!). Csak
# szerver oldalon használt, SOHA nem NEXT_PUBLIC_ prefixszel.
PLANNER_SUPABASE_SERVICE_ROLE_KEY=your_planner_supabase_service_role_key

# Egyszerű, kézzel összeállított programterv (planner.trip_plans) -- ez a
# valós ügyfélfolyamat, a fenti wizard/flow-szerkesztőtől függetlenül
# kapcsolható. Ugyanazt a planner Supabase projektet használja.
NEXT_PUBLIC_FEATURE_TRIP_PLANS=false
