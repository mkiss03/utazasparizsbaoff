# Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Programszervező modul (planner) -- lásd a tervdokumentumot.
# Csak Preview/dev környezetben állítsd true-ra. Production env-ben ne
# módosítsd -- a modul a middleware-ben flag nélkül 404-et ad.
NEXT_PUBLIC_FEATURE_PLANNER=false

# Karbantartási mód (lásd lib/maintenance.ts). Alapból KI van kapcsolva.
# MAINTENANCE_MODE=on esetén a nyilvános oldalak helyett "karbantartás alatt"
# oldal látszik, noindex jelzéssel; az /admin elérhető marad. A változtatás
# új deploy után lép életbe.
# MAINTENANCE_MODE=on
# Előnézet karbantartás közben: <oldal>/?preview=<token> megnyitása után az
# adott böngészőben 7 napig a szokásos oldal látszik. Hosszú, véletlen érték legyen.
# MAINTENANCE_BYPASS_TOKEN=
